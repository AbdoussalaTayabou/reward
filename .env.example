# ============================================================
# VARIABLES D'ENVIRONNEMENT — PRODUCTION RENDER
# Ne jamais committer les valeurs réelles dans Git !
# Copiez ce fichier en .env pour le dev local uniquement.
# ============================================================

# Flask
SECRET_KEY=change-me-with-a-long-random-string-in-prod

# Base de données
# - En local : sqlite:///rewards.db
# - Sur Render : injecté automatiquement via render.yaml (fromDatabase)
DATABASE_URL=sqlite:///rewards.db

# Règles métier
POINTS_PER_EUR=1000
MIN_WITHDRAW_EUR=5
REFERRAL_BONUS_POINTS=500

# PayPal
PAYPAL_MODE=sandbox        # "live" en production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# TimeWall
TIMEWALL_APP_KEY=
TIMEWALL_SECRET=
TIMEWALL_HASH_ALGO=sha256
TIMEWALL_ALLOWED_IPS=      # IPs TimeWall en prod, ex: 1.2.3.4,5.6.7.8
