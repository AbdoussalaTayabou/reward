SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///rewards.db
# Conversion : 1000 points = 1 EUR
POINTS_PER_EUR=1000
MIN_WITHDRAW_EUR=5
REFERRAL_BONUS_POINTS=500
# PayPal (mode sandbox ou live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- TimeWall ---
# Récupérés depuis ton dashboard publisher TimeWall
TIMEWALL_APP_KEY=
TIMEWALL_SECRET=
# Algo de hash de la signature (TimeWall fournit la valeur exacte dans ton placement) :
# sha256 (recommandé) | md5 | sha1
TIMEWALL_HASH_ALGO=sha256
# Liste d'IPs ou CIDR autorisés à frapper /timewall/postback, séparés par des virgules.
# Vide = pas de filtre (à n'utiliser qu'en dev). En prod, mets les IPs fournies par TimeWall.
TIMEWALL_ALLOWED_IPS=
